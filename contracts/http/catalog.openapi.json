{
  "openapi": "3.1.1",
  "info": {
    "title": "UMC Care - Catalog",
    "version": "0.1.0",
    "description": "Week-one implementation contract from API86 v5.2 / ERD v5. Health endpoints are technical and documented separately. JWT/lease claims and event envelope require integration agreement with Identity/Gateway owners."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8081",
      "description": "Huy local service, before Gateway integration"
    }
  ],
  "tags": [
    {
      "name": "Catalog"
    }
  ],
  "paths": {
    "/api/v1/departments": {
      "get": {
        "operationId": "CA_001",
        "summary": "List active departments",
        "description": "Public; stable ordering by name/id.",
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,100}$"
            },
            "description": "Optional. Missing/unsafe value is replaced by a server UUID."
          }
        ],
        "security": [],
        "responses": {
          "400": {
            "description": "Invalid input",
            "headers": {
              "X-Correlation-ID": {
                "description": "Correlation ID for this response",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database or required Identity verification unavailable",
            "headers": {
              "X-Correlation-ID": {
                "description": "Correlation ID for this response",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "headers": {
              "X-Correlation-ID": {
                "description": "Correlation ID for this response",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepartmentsResponse"
                }
              }
            }
          }
        }
      }
    },
