    "/api/v1/prices": {
      "post": {
        "operationId": "CA_004",
        "summary": "Create an immutable future price version",
        "description": "STAFF with ADMIN in verified JWT and current access projection; requires an RS256 authorization lease for action CA-004, at most 30 seconds. effectiveFrom >= server now + 5 minutes; periods are half-open [from,to), missing/null to is unbounded; no automatic closing of old prices. Price, idempotency response, sequence and outbox insert commit atomically. Same actor/key + canonical body replays original 201, including after effectiveFrom; changed body is 409. Int64 VND; browser form restricts writes to safe integers. Maximum body 64 KiB. Unknown JSON fields are rejected.",
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,100}$"
            },
            "description": "Optional. Missing/unsafe value is replaced by a server UUID."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": ""
          }
        ],
        "security": [
          {
            "bearerAuth": [],
            "authorizationLease": []
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid input",
            "headers": {
              "X-Correlation-ID": {
                "description": "Correlation ID for this response",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database or required Identity verification unavailable",
            "headers": {
              "X-Correlation-ID": {
                "description": "Correlation ID for this response",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired bearer",
            "headers": {
              "X-Correlation-ID": {
                "description": "Correlation ID for this response",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient current permission or authorization lease",
            "headers": {
              "X-Correlation-ID": {
                "description": "Correlation ID for this response",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "OVERLAPPING_PRICE_PERIOD or IDEMPOTENCY_CONFLICT",
            "headers": {
              "X-Correlation-ID": {
                "description": "Correlation ID for this response",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "201": {
            "description": "Created (also on an idempotent replay)",
            "headers": {
              "X-Correlation-ID": {
                "description": "Correlation ID for this response",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriceInput"
              },
              "example": {
                "itemType": "EXAM",
                "itemId": "00000000-0000-4000-8000-000000000201",
                "amountVnd": 150000,
                "effectiveFrom": "2026-11-10T02:00:00Z",
                "effectiveTo": "2026-11-11T02:00:00Z"
              }
            }
          }
        }
      }
    },
