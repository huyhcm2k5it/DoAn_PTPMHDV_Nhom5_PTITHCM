          },
          "unit": {
            "type": "string"
          },
          "strength": {
            "type": "string"
          },
          "form": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
