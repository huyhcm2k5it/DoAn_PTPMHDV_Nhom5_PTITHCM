          "code",
          "name",
          "status"
        ],
        "additionalProperties": false
      },
      "Doctor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        },
        "required": [
          "id",
          "departmentId",
          "displayName",
          "status"
        ],
        "additionalProperties": false
      },
      "PriceInput": {
        "type": "object",
        "properties": {
          "itemType": {
            "type": "string",
            "enum": [
              "EXAM",
              "LAB",
              "MEDICINE"
            ]
          },
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "amountVnd": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time",
            "pattern": "T\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,6})?(?:Z|[+-]\\d{2}:\\d{2})$",
            "description": "At most 6 fractional-second digits (PostgreSQL microsecond precision)"
          },
          "effectiveTo": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "pattern": "T\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,6})?(?:Z|[+-]\\d{2}:\\d{2})$",
            "description": "At most 6 fractional-second digits (PostgreSQL microsecond precision)"
          }
        },
        "required": [
          "itemType",
          "itemId",
          "amountVnd",
          "effectiveFrom"
        ],
        "additionalProperties": false
      },
      "Price": {
        "type": "object",
        "properties": {
          "priceVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "itemType": {
            "type": "string",
            "enum": [
              "EXAM",
              "LAB",
              "MEDICINE"
            ]
          },
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "amountVnd": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time",
            "pattern": "T\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,6})?(?:Z|[+-]\\d{2}:\\d{2})$",
            "description": "At most 6 fractional-second digits (PostgreSQL microsecond precision)"
          },
          "effectiveTo": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "pattern": "T\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,6})?(?:Z|[+-]\\d{2}:\\d{2})$",
            "description": "At most 6 fractional-second digits (PostgreSQL microsecond precision)"
          }
        },
        "required": [
          "priceVersionId",
          "revision",
          "itemType",
          "itemId",
          "amountVnd",
          "effectiveFrom"
