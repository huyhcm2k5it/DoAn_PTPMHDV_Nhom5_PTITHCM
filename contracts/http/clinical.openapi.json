  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT (RS256)"
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "correlationId"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "required": [
          "error",
          "meta"
        ],
        "additionalProperties": false
      },
      "StartInput": {
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string",
            "format": "uuid"
          },
          "doctorId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedTicketVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "ticketId",
          "doctorId",
          "expectedTicketVersion"
        ],
        "additionalProperties": false
      },
      "DraftInput": {
        "type": "object",
        "properties": {
          "symptoms": {
            "type": "string",
            "maxLength": 10000
          },
          "findings": {
            "type": "string",
            "maxLength": 10000
          },
          "assessment": {
            "type": "string",
            "maxLength": 10000
          },
          "diagnosis": {
            "type": "string",
            "maxLength": 10000
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "symptoms",
          "findings",
          "assessment",
          "diagnosis",
          "expectedVersion"
        ],
        "additionalProperties": false
      },
      "StartResult": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "const": "PENDING"
          },
          "statusUrl": {
            "type": "string",
            "format": "uri-reference"
          }
        },
        "required": [
          "requestId",
          "operationId",
          "state",
          "statusUrl"
        ],
        "additionalProperties": false
      },
      "StartRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "REJECTED"
            ]
          },
          "statusUrl": {
            "type": "string",
            "format": "uri-reference"
          },
          "visitId": {
            "type": "string",
            "format": "uuid"
          },
          "reasonCode": {
            "type": "string",
            "maxLength": 100
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "requestId",
          "operationId",
          "state",
          "statusUrl",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "Visit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "appointmentId": {
            "type": "string",
            "format": "uuid"
          },
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "doctorUserId": {
            "type": "string",
            "format": "uuid"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
          "claimId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "IN_PROGRESS",
              "LAB_REQUEST_PENDING",
              "WAITING_LAB",
              "RETURN_READY",
              "WAITING_RETURN",
              "SIGNED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "returnRound": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "signedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "appointmentId",
          "patientId",
          "doctorUserId",
          "departmentId",
          "claimId",
          "state",
          "version",
          "returnRound",
          "startedAt"
        ],
        "additionalProperties": false
      },
      "VisitNote": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "visitId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "symptoms": {
            "type": "string",
            "maxLength": 10000
          },
          "findings": {
            "type": "string",
            "maxLength": 10000
          },
          "assessment": {
            "type": "string",
            "maxLength": 10000
          },
          "diagnosis": {
            "type": "string",
            "maxLength": 10000
          },
          "authorUserId": {
            "type": "string",
            "format": "uuid"
          },
          "savedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "visitId",
          "revision",
          "symptoms",
          "findings",
          "assessment",
          "diagnosis",
          "authorUserId",
          "savedAt"
        ],
        "additionalProperties": false
      },
      "Worklist": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Visit"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "startRequest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StartRequest"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "total",
          "startRequest"
        ],
        "additionalProperties": false
      },
      "VisitDetail": {
        "type": "object",
        "properties": {
          "visit": {
            "$ref": "#/components/schemas/Visit"
          },
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisitNote"
            }
          },
          "prescriptions": {
            "type": "array",
            "items": {}
          },
          "labRequests": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "visit",
          "notes",
          "prescriptions",
          "labRequests"
        ],
        "additionalProperties": false
      },
      "DraftResult": {
        "type": "object",
        "properties": {
          "visitId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "state": {
            "type": "string",
            "enum": [
              "IN_PROGRESS",
              "LAB_REQUEST_PENDING",
              "WAITING_LAB",
              "RETURN_READY",
              "WAITING_RETURN",
              "SIGNED"
            ]
          }
        },
        "required": [
          "visitId",
          "version",
          "state"
        ],
        "additionalProperties": false
      },
      "StartResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/StartResult"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      "WorklistResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Worklist"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      "VisitDetailResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/VisitDetail"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      "DraftResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/DraftResult"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false
      }
    }
  }
}
