              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "requestId",
            "visitId",
            "state",
            "version"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "CREATED"
                  }
                }
              },
              "then": {
                "required": [
                  "orderId"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "REJECTED"
                  }
                }
              },
              "then": {
                "required": [
                  "reasonCode"
                ],
                "properties": {
                  "reasonCode": {
                    "minLength": 1
                  }
                }
              }
            }
