{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umc-care:pharmacy:v1",
  "title": "Pharmacy and Prescription v1 Events",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "messageKind", "messageType", "schemaVersion", "producer", "aggregateId", "aggregateVersion", "correlationId", "causationId", "requestId", "occurredAt", "payload"],
      "properties": {
        "messageId": { "type": "string", "format": "uuid" },
        "messageKind": { "const": "EVENT" },
        "messageType": { "const": "PrescriptionFinalized" },
        "schemaVersion": { "const": 1 },
        "producer": { "const": "clinical" },
        "aggregateId": { "type": "string", "format": "uuid" },
        "aggregateVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "causationId": { "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
        "requestId": { "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
        "occurredAt": { "type": "string", "format": "date-time" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prescriptionId", "revision", "visitId", "patientId", "itemsSnapshot", "finalizedAt"],
          "properties": {
            "prescriptionId": { "type": "string", "format": "uuid" },
            "revision": { "type": "integer", "minimum": 1 },
            "visitId": { "type": "string", "format": "uuid" },
            "patientId": { "type": "string", "format": "uuid" },
            "itemsSnapshot": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["medicineCode", "quantity"],
                "properties": {
                  "medicineCode": { "type": "string", "minLength": 1 },
                  "quantity": { "type": "integer", "minimum": 1 },
                  "nameSnapshot": { "type": "string" },
                  "doseText": { "type": "string" },
                  "instruction": { "type": "string" }
                }
              }
            },
            "finalizedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "messageKind", "messageType", "schemaVersion", "producer", "aggregateId", "aggregateVersion", "correlationId", "causationId", "requestId", "occurredAt", "payload"],
      "properties": {
        "messageId": { "type": "string", "format": "uuid" },
        "messageKind": { "const": "EVENT" },
        "messageType": { "const": "MedicationHoldChanged" },
        "schemaVersion": { "const": 1 },
        "producer": { "const": "pharmacy" },
        "aggregateId": { "type": "string", "format": "uuid" },
        "aggregateVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "causationId": { "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
        "requestId": { "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
        "occurredAt": { "type": "string", "format": "date-time" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["holdId", "attemptNo", "changeType", "version"],
          "properties": {
            "holdId": { "type": "string", "format": "uuid" },
            "attemptNo": { "type": "integer", "minimum": 1 },
            "chargeId": { "type": "string", "format": "uuid" },
            "changeType": { "enum": ["HELD", "RELEASED", "EXPIRED", "COMMITTED"] },
            "cancellationId": { "type": "string", "format": "uuid" },
            "version": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "messageKind", "messageType", "schemaVersion", "producer", "aggregateId", "aggregateVersion", "correlationId", "causationId", "requestId", "occurredAt", "payload"],
      "properties": {
        "messageId": { "type": "string", "format": "uuid" },
        "messageKind": { "const": "EVENT" },
        "messageType": { "const": "MedicationDispensed" },
        "schemaVersion": { "const": 1 },
        "producer": { "const": "pharmacy" },
        "aggregateId": { "type": "string", "format": "uuid" },
        "aggregateVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "causationId": { "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
        "requestId": { "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
        "occurredAt": { "type": "string", "format": "date-time" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prescriptionId", "revision", "holdId", "attemptNo", "recipientUserId", "dispensedAt"],
          "properties": {
            "prescriptionId": { "type": "string", "format": "uuid" },
            "revision": { "type": "integer", "minimum": 1 },
            "holdId": { "type": "string", "format": "uuid" },
            "attemptNo": { "type": "integer", "minimum": 1 },
            "recipientUserId": { "type": "string", "format": "uuid" },
            "dispensedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}
