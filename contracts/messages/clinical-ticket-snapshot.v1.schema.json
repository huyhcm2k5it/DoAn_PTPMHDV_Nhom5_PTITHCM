{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umc-care:clinical-ticket-import:v1",
  "title": "Trusted Appointment snapshot import (provisional handoff, not a public event)",
  "type": "array",
  "maxItems": 1000,
  "items": {
    "type": "object",
    "properties": {
      "ticketId": {
        "type": "string",
        "format": "uuid"
      },
      "appointmentId": {
        "type": "string",
        "format": "uuid"
      },
      "patientId": {
        "type": "string",
        "format": "uuid"
      },
      "doctorId": {
        "type": "string",
        "format": "uuid"
      },
      "doctorUserId": {
        "type": "string",
        "format": "uuid"
      },
      "departmentId": {
        "type": "string",
        "format": "uuid"
      },
      "visitId": {
        "type": "string",
        "format": "uuid"
      },
      "ticketType": {
        "enum": [
          "FIRST",
          "RETURN"
        ]
      },
      "state": {
        "enum": [
          "WAITING",
          "CALLED",
          "CLAIMED",
          "NO_SHOW",
          "DONE"
        ]
      },
      "version": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    },
    "required": [
      "ticketId",
      "appointmentId",
      "patientId",
      "doctorId",
      "doctorUserId",
      "departmentId",
      "ticketType",
      "state",
      "version"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "ticketType": {
              "const": "RETURN"
            }
          }
        },
        "then": {
          "required": [
            "visitId"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "ticketType": {
              "const": "FIRST"
            }
          }
        },
        "then": {
          "not": {
            "required": [
              "visitId"
            ]
          }
        }
      }
    ]
  }
}
