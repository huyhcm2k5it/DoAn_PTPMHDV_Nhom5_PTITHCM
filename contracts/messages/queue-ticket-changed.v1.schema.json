{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:umc-care:queue-ticket-changed:v1",
  "allOf": [
    {
      "$ref": "urn:umc-care:common-envelope:v1"
    },
    {
      "properties": {
        "messageKind": {
          "const": "EVENT"
        },
        "messageType": {
          "const": "QueueTicketChanged"
        },
        "producer": {
          "const": "appointment"
        },
        "payload": {
          "type": "object",
          "properties": {
            "ticketId": {
              "type": "string",
              "format": "uuid"
            },
            "appointmentId": {
              "type": "string",
              "format": "uuid"
            },
            "patientId": {
              "type": "string",
              "format": "uuid"
            },
            "doctorId": {
              "type": "string",
              "format": "uuid"
            },
            "doctorUserId": {
              "type": "string",
              "format": "uuid"
            },
            "departmentId": {
              "type": "string",
              "format": "uuid"
            },
            "visitId": {
              "type": "string",
              "format": "uuid"
            },
            "ticketType": {
              "enum": [
                "FIRST",
                "RETURN"
              ]
            },
            "state": {
              "enum": [
                "WAITING",
                "CALLED",
                "CLAIMED",
                "IN_SERVICE",
                "NO_SHOW",
                "DONE"
              ]
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "ticketId",
            "appointmentId",
            "patientId",
            "doctorId",
            "doctorUserId",
            "departmentId",
            "ticketType",
            "state",
            "version"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "ticketType": {
                    "const": "RETURN"
                  }
                }
              },
              "then": {
                "required": [
                  "visitId"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "ticketType": {
                    "const": "FIRST"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "visitId"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ]
}
