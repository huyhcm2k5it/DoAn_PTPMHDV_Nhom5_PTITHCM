{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-build",
    "types": ["node"]
  },
  "include": ["mongo/**/*.ts", "services/patient/src/db/**/*.ts", "services/appointment/src/db/**/*.ts", "services/pharmacy/src/db/**/*.ts", "tests/mongo/**/*.ts"]
}
