DATABASE_URL=postgres://catalog_owner:replace-with-local-password@127.0.0.1:55432/catalog_db?sslmode=disable
LISTEN_ADDR=127.0.0.1:8081
# Public reads work without Identity settings. Protected routes fail closed.
# Configure all three together using Identity's actual signing public key.
# JWT_ISSUER=identity-issuer-agreed-with-hung
# JWT_AUDIENCE=catalog
# JWT_PUBLIC_KEY_FILE=C:/path/to/identity-public.pem
# LEASE_PUBLIC_KEY_FILE=C:/path/to/identity-lease-public.pem
