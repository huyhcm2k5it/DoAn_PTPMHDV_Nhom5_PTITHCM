{
  "name": "@umc-care/appointment-service",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/main.js",
    "check": "node scripts/check-js.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:dry-run": "node scripts/seed-demo.js --dry-run",
    "expire:holds": "node scripts/expire-holds.js",
    "expire:appointments": "node scripts/expire-appointments.js",
    "test:integration": "node --test --test-concurrency=1 ../../tests/mongo/booking.test.js ../../tests/mongo/access-projection.test.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "9.11.4"
  }
}
