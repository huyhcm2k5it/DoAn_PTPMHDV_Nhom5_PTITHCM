    },
    {
      "name": "BI-009: Trạng thái chi tiết yêu cầu hoàn tiền",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffAccessToken}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/refunds/{{refundId}}"
        }
      }
    },
    {
      "name": "BI-010: Báo cáo thu/hoàn viện phí (ADMIN)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffAccessToken}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/admin/reports/summary?from=2026-10-01&to=2026-11-30"
