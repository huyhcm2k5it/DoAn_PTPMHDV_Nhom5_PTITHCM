{
  "info": {
    "_postman_id": "b2e8a1c4-5678-4321-98ab-cdef01234568",
    "name": "Billing Service Tests (Thunder / Postman)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Bộ test API Billing Service: Tra cứu charges, thu quầy, mô phỏng thanh toán, e-receipt, refund, báo cáo admin."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "staffAccessToken",
      "value": ""
    },
    {
      "key": "patientAccessToken",
      "value": ""
    },
    {
      "key": "chargeId",
      "value": "a0000000-0000-0000-0000-000000000001"
    },
    {
      "key": "receiptId",
      "value": "r0000000-0000-0000-0000-000000000001"
    },
    {
      "key": "refundId",
      "value": "f0000000-0000-0000-0000-000000000001"
    }
  ],
  "item": [
    {
      "name": "0. Login STAFF (Lấy staffAccessToken CASHIER+ADMIN)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"0909999901\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/login"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.accessToken) {",
              "    pm.collectionVariables.set(\"staffAccessToken\", jsonData.data.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "0. Login PATIENT (Lấy patientAccessToken)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"0901234567\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/login"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.accessToken) {",
              "    pm.collectionVariables.set(\"patientAccessToken\", jsonData.data.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "BI-013: Danh sách khoản thu",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffAccessToken}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/charges?page=1&limit=20"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.items && jsonData.data.items.length > 0) {",
              "    pm.collectionVariables.set(\"chargeId\", jsonData.data.items[0].id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "BI-002: Chi tiết khoản thu",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffAccessToken}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/charges/{{chargeId}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.latestPayment && jsonData.data.latestPayment.receiptId) {",
              "    pm.collectionVariables.set(\"receiptId\", jsonData.data.latestPayment.receiptId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "BI-004: Mô phỏng thanh toán (202 Accepted)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffAccessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pay-sim-b7dd18c8-98f3-4b1e-98a8-13c9ddef230d"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"chargeId\": \"{{chargeId}}\",\n  \"transactionId\": \"TX_SIM_001\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/payments/simulate"
        }
      }
    },
    {
      "name": "BI-003: Khoản thu theo hồ sơ bệnh nhân",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffAccessToken}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/patients/b0000000-0000-0000-0000-000000000001/charges"
        }
      }
    },
    {
      "name": "BI-005: Thu viện phí tại quầy (CASHIER)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffAccessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pay-counter-26d15203-3e0b-438b-a07b-b8a35785aa41"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"chargeId\": \"00000000-0000-4000-8000-000000000001\",\n  \"transactionId\": \"TX_COUNTER_001\",\n  \"method\": \"CASH\",\n  \"counterReference\": \"QUAY_01_REF_001\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/payments/counter"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.receiptId) {",
              "    pm.collectionVariables.set(\"receiptId\", jsonData.data.receiptId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "BI-006: Chi tiết biên nhận điện tử",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffAccessToken}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/receipts/{{receiptId}}"
        }
      }
    },
    {
      "name": "BI-007: Tạo yêu cầu hoàn tiền",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffAccessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "refund-9f5fddaa-f09f-4b69-bf60-e51d820209e5"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"chargeId\": \"{{chargeId}}\",\n  \"sourceId\": \"c0000000-0000-0000-0000-000000000001\",\n  \"reasonCode\": \"PATIENT_CANCEL\",\n  \"amountVnd\": 150000\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/refunds"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.refund && jsonData.data.refund.id) {",
              "    pm.collectionVariables.set(\"refundId\", jsonData.data.refund.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "BI-014: Danh sách hàng chờ hoàn tiền",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffAccessToken}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/refunds?state=REQUESTED"
        }
      }
    },
    {
      "name": "BI-008: Thực thi hoàn tiền mô phỏng",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffAccessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "refund-exec-d674bff8-c53e-4b08-a6a5-cfb6cef994e2"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactionId\": \"TX_REFUND_SIM_001\",\n  \"scenario\": \"SUCCESS\",\n  \"expectedVersion\": 1\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/refunds/{{refundId}}/execute"
        }
