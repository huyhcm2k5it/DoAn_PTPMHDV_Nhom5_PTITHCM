DJANGO_SECRET_KEY=change-this-in-production-secret-key
DEBUG=False
PORT=8000

# PostgreSQL
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_owner
BILLING_DB_PASSWORD=YOUR_PASSWORD_HERE
BILLING_DB_HOST=postgres
BILLING_DB_PORT=5432

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=umc_app
RABBITMQ_PASSWORD=YOUR_RABBITMQ_PASSWORD_HERE
RABBITMQ_VHOST=/umc-care

# Xác thực JWT do Identity phát hành (RS256)
# Public key được copy sẵn vào image tại /app/jwt_public.pem nên không cần mount thêm.
# Nếu mount key từ ngoài vào thì đổi đường dẫn này cho khớp.
JWT_PUBLIC_KEY_PATH=/app/jwt_public.pem
JWT_ISSUER=umc-care-identity
JWT_AUDIENCE=umc-care-services
