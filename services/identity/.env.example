DJANGO_SECRET_KEY=change-this-in-production-secret-key
DEBUG=True
PORT=8000

# PostgreSQL
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_owner
IDENTITY_DB_PASSWORD=YOUR_PASSWORD_HERE
IDENTITY_DB_HOST=postgres
IDENTITY_DB_PORT=5432

# Đường dẫn private key RSA (nếu cần đổi)
JWT_PRIVATE_KEY_PATH=/app/jwt_private.pem