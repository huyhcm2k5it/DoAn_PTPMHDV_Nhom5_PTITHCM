{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": ".test-build",
    "types": [
      "node"
    ],
    "paths": {
      "mongodb": [
        "./node_modules/mongodb"
      ]
    }
  },
  "include": [
    "../../mongo/**/*.ts",
    "../../services/patient/src/db/**/*.ts",
    "../../services/appointment/src/db/**/*.ts",
    "../../services/pharmacy/src/db/**/*.ts",
    "./*.test.ts"
  ]
}
