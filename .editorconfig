root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_size = 2

[services/patient/**]
end_of_line = lf

[services/appointment/**]
end_of_line = lf

[services/pharmacy/**]
end_of_line = lf

[apps/web/**]
end_of_line = lf

[*.sh]
end_of_line = lf
