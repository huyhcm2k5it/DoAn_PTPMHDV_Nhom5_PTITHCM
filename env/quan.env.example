# Copy to env/quan.env. Quân owns MongoDB, RabbitMQ and Appointment Redis.
# Use the same RabbitMQ account in DEFAULT_*, RABBITMQ_* and UMC_AMQP_URL.
MONGO_ROOT_USER=local-root
MONGO_ROOT_PASSWORD=replace_with_random_password
PATIENT_DB_PASSWORD=replace_with_random_password
APPOINTMENT_DB_PASSWORD=replace_with_random_password
PHARMACY_DB_PASSWORD=replace_with_random_password
PATIENT_MONGO_URI=mongodb://patient-service:REPLACE@mongo:27017/patient_db?authSource=patient_db&replicaSet=rs0
APPOINTMENT_MONGO_URI=mongodb://appointment-service:REPLACE@mongo:27017/appointment_db?authSource=appointment_db&replicaSet=rs0
PHARMACY_MONGO_URI=mongodb://pharmacy-service:REPLACE@mongo:27017/pharmacy_db?authSource=pharmacy_db&replicaSet=rs0
RABBITMQ_DEFAULT_USER=local-worker
RABBITMQ_DEFAULT_PASS=replace_with_random_password
RABBITMQ_DEFAULT_VHOST=/umc-care
RABBITMQ_USER=local-worker
RABBITMQ_PASSWORD=replace_with_same_rabbit_password
UMC_AMQP_URL=amqp://local-worker:REPLACE@rabbitmq:5672/%2Fumc-care
APPOINTMENT_REDIS_PASSWORD=replace_with_random_password
