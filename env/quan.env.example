# Copy to env/quan.env. Quân owns Patient, Appointment, Pharmacy and shared RabbitMQ.
# Online-only target template. Current Compose still needs local infrastructure variables.
# Replace every REPLACE value; never commit env/quan.env.
GATEWAY_HOST_PORT=8080
PATIENT_PORT=8001
APPOINTMENT_PORT=8002
PHARMACY_PORT=8003

# Each MongoDB Atlas URI selects only its owner's database.
PATIENT_MONGO_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_PATIENT_CLUSTER.mongodb.net/patient_db?retryWrites=true&w=majority&authSource=admin
APPOINTMENT_MONGO_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_APPOINTMENT_CLUSTER.mongodb.net/appointment_db?retryWrites=true&w=majority&authSource=admin
PHARMACY_MONGO_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_PHARMACY_CLUSTER.mongodb.net/pharmacy_db?retryWrites=true&w=majority&authSource=admin

# One online broker/vhost for the group. Huy and Hưng workers use this URL.
UMC_AMQP_URL=amqps://REPLACE_USER:REPLACE_PASSWORD@REPLACE_BROKER_HOST:5671/REPLACE_VHOST
# Django workers also read the same online broker as separate host/user fields.
# Keep these values consistent with UMC_AMQP_URL; do not use a second broker.
RABBITMQ_HOST=REPLACE_BROKER_HOST
RABBITMQ_PORT=5671
RABBITMQ_VHOST=REPLACE_VHOST
RABBITMQ_USER=REPLACE_USER
RABBITMQ_PASSWORD=REPLACE_PASSWORD

# Appointment online Redis cache; rediss:// enables TLS.
APPOINTMENT_REDIS_URL=rediss://REPLACE_USER:REPLACE_PASSWORD@REPLACE_REDIS_HOST:6380
