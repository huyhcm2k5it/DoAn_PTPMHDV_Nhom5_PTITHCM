# Copy to env/hung.env. Hưng owns Identity, Billing and Notification.
# Online-only template. Replace every REPLACE value; never commit env/hung.env.
IDENTITY_PORT=8004
BILLING_PORT=8005
NOTIFICATION_PORT=8006

IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=REPLACE_USER
IDENTITY_DB_HOST=REPLACE_AIVEN_HOST
IDENTITY_DB_PORT=REPLACE_AIVEN_PORT
IDENTITY_DB_SSLMODE=require
IDENTITY_DB_PASSWORD=REPLACE_PASSWORD
BILLING_DB_NAME=billing_db
BILLING_DB_USER=REPLACE_USER
BILLING_DB_HOST=REPLACE_AIVEN_HOST
BILLING_DB_PORT=REPLACE_AIVEN_PORT
BILLING_DB_SSLMODE=require
BILLING_DB_PASSWORD=REPLACE_PASSWORD
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=REPLACE_USER
NOTIFICATION_DB_HOST=REPLACE_AIVEN_HOST
NOTIFICATION_DB_PORT=REPLACE_AIVEN_PORT
NOTIFICATION_DB_SSLMODE=require
NOTIFICATION_DB_PASSWORD=REPLACE_PASSWORD

# One JWT key pair for the group. Only Identity receives the private key.
# Base64 is encoding, not encryption. A preparation step must derive public PEM/JWKS;
# current Compose does not consume this variable yet.
JWT_PRIVATE_KEY_B64=REPLACE_BASE64_PKCS8_RSA_PRIVATE_PEM
JWT_ISSUER=umc-care-identity
JWT_AUDIENCE=umc-care-services

DJANGO_SECRET_KEY=REPLACE_RANDOM_SECRET
DEBUG=False
ALLOW_DEV_OTP=false
SMS_BACKEND=http
SMS_HTTP_URL=https://REPLACE_SMS_PROVIDER_ENDPOINT
SMS_HTTP_TOKEN=REPLACE_SMS_TOKEN
SMS_BRANDNAME=UMCCare

# RabbitMQ comes from Quân's UMC_AMQP_URL; do not duplicate its credential.
