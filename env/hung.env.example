# Copy to env/hung.env. Hưng owns Identity, Billing and Notification.
POSTGRES_PASSWORD=replace_with_random_password
IDENTITY_PORT=8004
BILLING_PORT=8005
NOTIFICATION_PORT=8006
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_owner
IDENTITY_DB_HOST=postgres
IDENTITY_DB_PORT=5432
IDENTITY_DB_SSLMODE=prefer
IDENTITY_DB_PASSWORD=replace_with_different_random_password
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_owner
BILLING_DB_HOST=postgres
BILLING_DB_PORT=5432
BILLING_DB_SSLMODE=prefer
BILLING_DB_PASSWORD=replace_with_different_random_password
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_owner
NOTIFICATION_DB_HOST=postgres
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_SSLMODE=prefer
NOTIFICATION_DB_PASSWORD=replace_with_different_random_password
# RabbitMQ worker connection for Hưng services; online TLS uses amqps://HOST:5671/...
HUNG_AMQP_URL=amqp://local-worker:REPLACE@rabbitmq:5672/%2Fumc-care
# For online PostgreSQL, set each owner's reachable host, port, DB, user,
# password and SSLMODE=require. Do not paste one DSN into another owner's DB.
DJANGO_SECRET_KEY=replace_with_random_secret
DEBUG=False
ALLOW_DEV_OTP=true
SMS_BACKEND=dev_inbox
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_BRANDNAME=UMCCare
JWT_ISSUER=umc-care-identity
JWT_AUDIENCE=umc-care-services
