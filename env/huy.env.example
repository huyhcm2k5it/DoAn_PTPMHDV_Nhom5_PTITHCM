# Copy to env/huy.env. Huy owns Catalog, Clinical and Diagnostic.
# Passwords embedded in DATABASE_URL must contain only URL-safe characters.
CATALOG_PORT=8007
CLINICAL_PORT=8008
DIAGNOSTIC_PORT=8009
HUY_POSTGRES_PASSWORD=replace_with_random_password
CATALOG_DB_PASSWORD=replace_with_different_random_password
CLINICAL_DB_PASSWORD=replace_with_different_random_password
DIAGNOSTIC_DB_PASSWORD=replace_with_different_random_password
CATALOG_REDIS_PASSWORD=replace_with_different_random_password
# Replace each URL with its own online PostgreSQL DSN when running against Neon.
# Online example: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
CATALOG_DATABASE_URL=postgres://catalog_owner:REPLACE@postgres:5432/catalog_db?sslmode=disable
CLINICAL_DATABASE_URL=postgres://clinical_owner:REPLACE@postgres:5432/clinical_db?sslmode=disable
DIAGNOSTIC_DATABASE_URL=postgres://diagnostic_owner:REPLACE@postgres:5432/diagnostic_db?sslmode=disable
# RabbitMQ worker connection for Huy services; online TLS uses amqps://HOST:5671/...
HUY_AMQP_URL=amqp://local-worker:REPLACE@rabbitmq:5672/%2Fumc-care
