# Copy to env/huy.env. Huy owns Catalog, Clinical and Diagnostic.
# Online-only target template. Current Compose still starts a local Redis container.
# Keep three separate databases; never commit env/huy.env.
CATALOG_PORT=8007
CLINICAL_PORT=8008
DIAGNOSTIC_PORT=8009

CATALOG_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_NEON_HOST/catalog_db?sslmode=require
CLINICAL_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_NEON_HOST/clinical_db?sslmode=require
DIAGNOSTIC_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_NEON_HOST/diagnostic_db?sslmode=require

# Catalog online Redis cache. RabbitMQ comes from Quân's UMC_AMQP_URL.
CATALOG_REDIS_URL=rediss://REPLACE_USER:REPLACE_PASSWORD@REPLACE_REDIS_HOST:6380
# Current Catalog code reads separate Redis fields; online TLS URL support is pending.
CATALOG_REDIS_ADDR=REPLACE_REDIS_HOST:6380
CATALOG_REDIS_USERNAME=REPLACE_USER
CATALOG_REDIS_PASSWORD=REPLACE_PASSWORD
